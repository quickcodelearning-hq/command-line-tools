#!/usr/bin/env zsh

set -euo pipefail

input="${1:-}"

if [[ -z "$input" ]]; then
    candidates=()

    for file in *.(m4v|mov|mp4)(N); do
        [[ "$file" == *" - Review.mp4" ]] && continue
        candidates+=("$file")
    done

    if (( ${#candidates[@]} == 0 )); then
        echo "No .m4v, .mov, or .mp4 video was found in this folder."
        exit 1
    fi

    if (( ${#candidates[@]} > 1 )); then
        echo "More than one source video was found:"
        printf '  %s\n' "${candidates[@]}"
        echo
        echo 'Run: atb-review "Exact File Name.m4v"'
        exit 1
    fi

    input="${candidates[1]}"
fi

if [[ ! -f "$input" ]]; then
    echo "File not found: $input"
    exit 1
fi

base="${input%.*}"
output="${base} - Review.mp4"

echo "Creating review copy..."
echo "Source: $input"
echo "Output: $output"
echo

ffmpeg \
    -hide_banner \
    -i "$input" \
    -vf "scale='min(1280,iw)':-2" \
    -c:v libx264 \
    -preset medium \
    -crf 24 \
    -pix_fmt yuv420p \
    -c:a aac \
    -b:a 128k \
    -movflags +faststart \
    "$output"

echo
echo "Finished:"
echo "$output"
