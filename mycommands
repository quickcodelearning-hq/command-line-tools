#!/bin/zsh
# Usage: mycommands [folder-prefix]; -h/--help/help show the complete guide.
# Keep the existing guide formatting. New *-tool(s) folders can supply their
# commands in README.md under "## Commands", without changes to this script.
show_guide() {
cat <<'HELP'
YOUR CUSTOM COMMANDS

  atb
    Go to ~/Documents/At The Books.

  atb 34
    Go to chapter 34; enter its Export folder if present.

  atb-review
    Create a smaller review MP4 from the single video in this folder.
    Automatically finds lowercase .m4v, .mov, and .mp4 files.

  atb-review "filename.mp4"
    Create a review copy of a specific video. Use this for uppercase
    extensions too, such as "filename.MP4". Keeps the original video.

  atb-backup
    Copy completed episodes to BOTH external drives:
      ATB-01A-500GB and ATB-01B-500GB
    Both drives must be mounted. Verifies file names and sizes,
    not content checksums. Does not delete local files.

  lshed help
    Show all Lead Shredder commands and options.

  lshed run --limit 10
    Find and export fresh leads. Calls Google and checks websites for emails.

  lshed dry-run --limit 5
    Preview fresh leads without writing CSV or history.
    Still calls Google; skips email lookup.

  lshed enrich --limit 100
    Look up emails for existing leads and update their SQLite/CSV records.
    Makes website requests.

  lshed retry-emails --limit 100
    Retry eligible missing emails. Respects cooldowns and attempt caps.
    Makes website requests and updates SQLite/CSV records.

  lshed history
    Show exported lead and unique practice totals (read-only).

  lshed test
    Run the application's mocked tests with temporary data.
    No live API calls or real lead enrichment.

  lshed status
    Show application paths, CSV count, and history totals (read-only).

  lshed doctor
    Check the existing virtual environment, files, and API-key presence.
    No network requests; never prints your key.

  mycommands
    Show this guide. This guide does not run any listed commands.

TOOLS LOCATION
  ~/Documents/code/command-line-tools

To add a command to this guide, edit mycommands in that folder.
HELP
}

if (( $# > 1 )); then
  print -u2 -r -- 'Usage: mycommands [folder-prefix]'
  exit 1
fi
prefix="${(L)1}"
case "$prefix" in
  -h|--help|help) prefix='' ;;
esac
# :A resolves the installed symlink; discovery never depends on the caller's cwd.
root="${0:A:h}"
guide="$(show_guide)"
[[ -n "$prefix" ]] || print -r -- "$guide"
matched=0
for folder in "$root"/*(N/); do
  name="${folder:t}"
  lower="${(L)name}"
  [[ "$lower" == *-tool || "$lower" == *-tools ]] || continue
  [[ "$lower" == "$prefix"* ]] || continue
  (( matched += 1 ))
  stem="${lower%-tools}"
  stem="${stem%-tool}"
  # Existing entries are blank-line-separated blocks whose command uses the
  # utility stem (e.g. stem, stem subcommand, or stem-suffix). No descriptions
  # are duplicated, and nothing in a utility folder is executed or sourced.
  entries="$(print -r -- "$guide" | awk -v stem="$stem" '
    BEGIN { RS=""; ORS="\n\n" }
    /^  [^ ]/ {
      command=tolower($1)
      if (command == stem || index(command, stem "-") == 1) print
    }
  ')"
  if [[ -z "$entries" && -r "$folder/README.md" ]]; then
    entries="$(awk '
      /^## Commands[[:space:]]*$/ { inside=1; next }
      /^## / { if (inside) exit }
      inside { print }
    ' "$folder/README.md")"
  elif [[ -z "$prefix" ]]; then
    # These commands were already printed in the original complete guide.
    continue
  fi
  print
  print -r -- "$name"
  if [[ -n "$entries" ]]; then
    print -r -- "$entries"
  else
    print -r -- '  No commands documented yet (add a ## Commands section to README.md).'
  fi
done
if (( matched == 0 )) && [[ -n "$prefix" ]]; then
  print -r -- "No utility folders start with '$1'. Try mycommands to see all commands."
fi
